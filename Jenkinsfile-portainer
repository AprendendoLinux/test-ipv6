pipeline {
    agent any // Roda no Jenkins (Prod), mas ações delegadas via SSH para Dev, exceto deploy
    environment {
        REPO_URL_BASE = 'https://github.com/AprendendoLinux/test-ipv6.git' // Repo privado
        GITHUB_REPO = 'AprendendoLinux/test-ipv6.git' // Repostiório no GitHub
        BRANCH_NAME = 'main'
        DOCKER_HUB_REPO = 'aprendendolinux/test-ipv6' // Docker Hub repo
        IMAGE_TAG = "${BUILD_ID}" // Versionamento com ID do build Jenkins
        APP_DIR = '/var/jenkins_home' // Diretório no Dev
        APP_NAME = 'test-ipv6' // Nome do app
        GITHUB_TOKEN_ID = 'gitauth_tokem' // ID da credencial Jenkins: Secret Text com PAT
        DOCKER_CREDS_ID = 'docker_auth' // ID da credencial Jenkins: Username with Password
        PROD_HOST = 'echelon.aprendendolinux.com' // Hostname ou IP do Prod
        PORTAINER_URL = 'http://portainer:9000' // URL do Portainer no Prod
        PORTAINER_CREDS_ID = 'portainer_auth' // ID da credencial Jenkins: Username with Password para Portainer
        STACK_NAME = 'test-ipv6' // Nome da stack no Portainer
        ENDPOINT_ID = 2 // ID fixo do ambiente 'echelon' identificado nos logs
        // Para capiturar o ENDPOINT_ID, use:
        // curl -s -X POST -H "Content-Type: application/json" -d '{"Username": "UsuarioDoPortainer", "Password": "SenhaDoPortainer"}' http://portainer:9000/api/auth
        // O comando acima vai retonar sua API. Com a API em mãos, faça:
        // curl -s -H "Authorization: Bearer SEU_TOKEN" http://portainer:9000/api/endpoints | jq -r '.[] | select(.Name == "nome-do-endpoint") | .Id'
    }

    stages {
        // stage('Git Clone no Dev') {
        //     steps {
        //         script {
        //             try {
        //                 withCredentials([string(credentialsId: "${GITHUB_TOKEN_ID}", variable: 'GIT_TOKEN')]) {
        //                     sh '''
        //                     rm -rf ${APP_DIR}/${APP_NAME}
        //                     cd ${APP_DIR}
        //                     git clone https://x-access-token:${GIT_TOKEN}@github.com/${GITHUB_REPO} -b ${BRANCH_NAME} ${APP_NAME}
        //                     echo "Repositório clonado no Dev, branch ${BRANCH_NAME}."
        //                     '''
        //                 }
        //             } catch (Exception e) {
        //                 echo "Erro no Git Clone: ${e.message}"
        //                 throw e
        //             }
        //         }
        //     }
        // }

        stage('Docker Login e Build da Imagem') {
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh """
                                cd ${WORKSPACE}/
                                docker login -u ${DOCKER_USER} -p ${DOCKER_PASS}
                                docker build -t ${DOCKER_HUB_REPO}:${IMAGE_TAG} .
                                echo 'Imagem construída no Dev.'
                            """
                        }
                    } catch (Exception e) {
                        echo "Erro no Login ou no Build da Imagem: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Push para Docker Hub') {
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDS_ID}", usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh """
                                cd ${WORKSPACE}
                                docker push ${DOCKER_HUB_REPO}:${IMAGE_TAG}
                                docker tag ${DOCKER_HUB_REPO}:${IMAGE_TAG} ${DOCKER_HUB_REPO}:latest
                                docker push ${DOCKER_HUB_REPO}:latest
                                echo 'Imagem pushada para Docker Hub.'
                            """
                        }
                    } catch (Exception e) {
                        echo "Erro Push para Docker Hub: ${e.message}"
                        throw e
                    }
                }
            }
        }

        stage('Deploy no Servidor Prod via Portainer') {
            steps {
                script {
                    try {
                        withCredentials([usernamePassword(credentialsId: "${PORTAINER_CREDS_ID}", usernameVariable: 'PORTAINER_USER', passwordVariable: 'PORTAINER_PASS')]) {
                            sh '''
                                # Obter token JWT do Portainer
                                TOKEN=$(curl -s -X POST "${PORTAINER_URL}/api/auth" \
                                    -H "Content-Type: application/json" \
                                    -d "{\\"Username\\":\\"${PORTAINER_USER}\\",\\"Password\\":\\"${PORTAINER_PASS}\\"}" | jq -r '.jwt')
                                if [ "$TOKEN" = "null" ] || [ -z "$TOKEN" ]; then
                                    echo "Erro: Token inválido."
                                    exit 1
                                fi

                                # Verificar e remover stack existente
                                STACK_ID=$(curl -s "${PORTAINER_URL}/api/stacks" \
                                    -H "Authorization: Bearer ${TOKEN}" | jq -r '.[] | select(.Name=="'${STACK_NAME}'") | .Id')
                                if [ ! -z "$STACK_ID" ]; then
                                    curl -s -X DELETE "${PORTAINER_URL}/api/stacks/${STACK_ID}?endpointId=${ENDPOINT_ID}" \
                                        -H "Authorization: Bearer ${TOKEN}" > /dev/null
                                    echo "Stack removida."
                                fi

                                # Criar nova stack
                                COMPOSE_CONTENT=$(cat "${APP_DIR}/${APP_NAME}/docker-compose.yml" | jq -sR .)
                                RESPONSE=$(curl -s -X POST "${PORTAINER_URL}/api/stacks/create/standalone/string?endpointId=${ENDPOINT_ID}" \
                                    -H "Authorization: Bearer ${TOKEN}" \
                                    -H "Content-Type: application/json" \
                                    -d "{\\"name\\":\\"${STACK_NAME}\\",\\"stackFileContent\\":${COMPOSE_CONTENT},\\"fromAppTemplate\\":false,\\"env\\":[]}")
                                if echo "$RESPONSE" | jq -e '.Id' > /dev/null 2>&1; then
                                    echo "Stack criada."
                                else
                                    echo "Erro ao criar a stack."
                                    exit 1
                                fi

                                # Verificar rede echelon
                                docker network ls | grep echelon || docker network create echelon

                                echo "Deploy concluído. Acesse http://${PROD_HOST}:8080"
                            '''
                        }
                    } catch (Exception e) {
                        echo "Erro no Deploy via Portainer: ${e.message}"
                        throw e
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline bem-sucedida! Deploy via Portainer concluído.'
        }
        failure {
            echo 'Pipeline falhou. Verifique logs, conexões SSH/Docker e API do Portainer no Prod.'
        }
    }
}